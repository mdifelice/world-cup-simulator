# Dependencies
node_modules/
target/

# Builds
dist/
build/

# Database & data artifacts
# Runtime SQLite databases live anywhere under these names and never get committed.
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.sqlite3

# data/ holds the real seed data (tracked exceptions below). Everything else in
# the folder — raw CSV sources, downloaded photos, and any SQLite file — is
# regenerable tooling/runtime state and stays local.
data/*
!data/seed/
!data/seed/*.json

pwtest-shots/
*.tmp

# TS build info
*.tsbuildinfo

# Environment / secrets
.env
.env.local
*.pem
.venv/
**/.venv/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
# Scraper caches / artifacts
server/scripts/.cache/
**/__pycache__/
